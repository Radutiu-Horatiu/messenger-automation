# ─────────────────────────────────────────────
# Facebook target
# ─────────────────────────────────────────────
# Full URL to watch. Either a Group feed OR a Messenger thread.
#   Group:     https://www.facebook.com/groups/000000000000000
#   Messenger: https://www.facebook.com/messages/t/000000000000000
FB_GROUP_URL=https://www.facebook.com/groups/000000000000000

# Platform is auto-detected from the URL (/messages/ => messenger).
# Override only if detection is wrong: group | messenger
# PLATFORM=

# Text to match against new posts/messages
TARGET_TEXT=Weekly Attendance

# Matching mode:
#   "exact"      -> normalized equality
#   "includes"   -> substring anywhere
#   "startsWith" -> message must begin with the target
# All modes are case-insensitive and ignore a space before punctuation.
MATCH_MODE=includes

# Which reaction to apply: like | love | care | haha | wow | sad | angry
REACTION=like

# ─────────────────────────────────────────────
# Scheduling (server local time unless TZ set)
# ─────────────────────────────────────────────
# Cron expression for when the daily session starts.
# Default: every Sunday at 10:00 -> "0 10 * * 0"
START_CRON=0 10 * * 0

# Hour (0-23) at which the session shuts down each day
STOP_HOUR=22

# Timezone used by the scheduler, e.g. "Europe/Bucharest", "UTC"
TZ=UTC

# ─────────────────────────────────────────────
# Storage / profile paths (Railway persistent volume = /data)
# ─────────────────────────────────────────────
DATA_DIR=/data
# Location of the exported Playwright storage state (login cookies)
STORAGE_STATE_PATH=/data/storageState.json
# Persistent browser profile directory
PROFILE_DIR=/data/facebook-profile
# Where reacted-post markers are persisted
REACTED_DB_PATH=/data/reacted.json

# ─────────────────────────────────────────────
# Browser
# ─────────────────────────────────────────────
# Run headless (true on servers, false locally for debugging/login)
HEADLESS=true
# Minutes between small human-like keep-alive interactions
KEEPALIVE_INTERVAL_MIN=3

# ─────────────────────────────────────────────
# Notifications
# ─────────────────────────────────────────────
# Optional Discord webhook for status pings
DISCORD_WEBHOOK_URL=

# ─────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────
LOG_LEVEL=info
